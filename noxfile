tasks:
  build:
    run: |
      mkdir -p build
      ldc2 -Iapp -Icore -Ilanguages/d -ofbuild/lapdance \
        app/lapdance/main.d core/lapdance/*.d languages/d/*.d
      ldc2 -Iapp -Icore -Ilanguages/d -ofbuild/lapdance_tests \
        tests/lapdance_tests.d core/lapdance/config.d core/lapdance/token.d \
        core/lapdance/formatter.d languages/d/formatter.d

  test:
    run: |
      mkdir -p build/debug/lapdance_tests
      ldc2 -Iapp -Icore -Ilanguages/d \
        -ofbuild/debug/lapdance_tests/lapdance_tests \
        tests/lapdance_tests.d core/lapdance/config.d core/lapdance/token.d \
        core/lapdance/formatter.d languages/d/formatter.d
      ./build/debug/lapdance/lapdance --version
      ./build/debug/lapdance_tests/lapdance_tests
      printf 'import std.stdio;\nvoid main() { writeln("ok"); }\n' > /tmp/lapdance_smoke.d
      ./build/debug/lapdance/lapdance format /tmp/lapdance_smoke.d
      ./build/debug/lapdance/lapdance check /tmp/lapdance_smoke.d

  check:
    run: ./build/debug/lapdance/lapdance check /tmp/lapdance_smoke.d

  clean:
    run: |
      rm -rf build /tmp/lapdance_smoke.d

  run:
    run: ./build/debug/lapdance/lapdance --help
