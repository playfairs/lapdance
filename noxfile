tasks:
  build:
    run: |
      mkdir -p build
      ldc2 -Iapp -Icore -ofbuild/lapdance \
        app/lapdance/main.d core/lapdance/*.d
      ldc2 -Iapp -Icore -ofbuild/lapdance_tests \
        tests/lapdance_tests.d core/lapdance/config.d core/lapdance/token.d \
        core/lapdance/formatter.d core/lapdance/document.d core/lapdance/parser.d

  test:
    run: |
      mkdir -p build/debug
      ldc2 -Iapp -Icore -ofbuild/debug/lapdance \
        app/lapdance/main.d core/lapdance/*.d
      ldc2 -Iapp -Icore -ofbuild/debug/lapdance_tests \
        tests/lapdance_tests.d core/lapdance/config.d core/lapdance/token.d \
        core/lapdance/formatter.d core/lapdance/document.d core/lapdance/parser.d
      ./build/debug/lapdance --version
      ./build/debug/lapdance_tests
      printf 'import std.stdio;\nvoid main() { writeln("ok"); }\n' > /tmp/lapdance_smoke.d
      ./build/debug/lapdance format /tmp/lapdance_smoke.d
      ./build/debug/lapdance check /tmp/lapdance_smoke.d

  check:
    run: ./build/debug/lapdance check /tmp/lapdance_smoke.d

  clean:
    run: |
      rm -rf build /tmp/lapdance_smoke.d

  run:
    run: ./build/debug/lapdance --help
