project "lapdance" {
    license = file("./UNLICENSE")

    executable.d "lapdance" {
        sources = [
            "app/lapdance/main.d",
            "core/lapdance/config.d",
            "core/lapdance/formatter.d",
            "core/lapdance/document.d",
            "core/lapdance/token.d",
            "core/lapdance/parser.d"
        ]
        flags = ["-Iapp", "-Icore"]
        install = true
    }
}
